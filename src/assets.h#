pub fn style_css() -> string is
    return ":root {\n  --cyan: #00e5ff;\n  --bg: #0a0e1a;\n  --bg2: #0d1120;\n  --card: #131929;\n  --line: #1e2a40;\n  --logbg: #0a0d16;\n  --setup: #060a12;\n  --text: #e6e9f2;\n  --muted: rgba(255, 255, 255, 0.54);\n  --soft: rgba(255, 255, 255, 0.7);\n  --faint: rgba(255, 255, 255, 0.38);\n  --border: rgba(255, 255, 255, 0.12);\n  --chip: rgba(255, 255, 255, 0.1);\n  --green: #69f0ae;\n  --red: #ff5252;\n  --blue: #448aff;\n  --orange: #ffab40;\n  --amber: #ffc107;\n}\n\n* { box-sizing: border-box; }\nhtml, body { margin: 0; padding: 0; height: 100%; }\nbody { background: var(--bg); color: var(--text); font-size: 14px; }\n\nbutton {\n  font-size: 14px;\n  color: var(--text);\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  padding: 0;\n  cursor: pointer;\n}\nbutton:disabled { opacity: 0.4; cursor: default; }\ninput[type='text'], input[type='number'] {\n  background: rgba(255, 255, 255, 0.06);\n  color: var(--text);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 8px 10px;\n  font-size: 14px;\n}\n\n/* ── typografia / pomocnicze ── */\n.muted { color: var(--muted); }\n.soft { color: var(--soft); }\n.faint { color: var(--faint); }\n.small { font-size: 12px; }\n.tiny { font-size: 11px; }\n.bold { font-weight: bold; }\n.center { text-align: center; }\n.spacer { flex: 1; }\n.cyan-text { color: var(--cyan); font-size: 14px; }\n\n/* ── start ── */\n.boot { height: 100vh; display: flex; align-items: center; justify-content: center; color: var(--muted); }\n\n/* ── powłoka ── */\n.shell { display: flex; flex-direction: column; height: 100vh; }\n.body { display: flex; flex: 1; min-height: 0; }\n.content { display: flex; flex: 1; min-width: 0; min-height: 0; }\n\n/* ── pasek górny ── */\n.topbar {\n  display: flex; align-items: center; gap: 10px;\n  height: 52px; padding: 0 16px;\n  background: var(--bg2); border-bottom: 1px solid var(--line);\n}\n.logo { color: var(--cyan); font-size: 20px; }\n.brand { color: var(--cyan); font-weight: bold; font-size: 18px; }\n.ver { color: var(--faint); font-size: 13px; margin-right: 14px; }\n.status { flex: 1; min-width: 0; color: var(--muted); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.tb-btn { padding: 6px 12px; font-size: 13px; border-radius: 8px; }\n.tb-btn.green { color: var(--green); }\n.tb-btn.red { color: var(--red); }\n.tb-btn.cyan { color: var(--cyan); }\n.tb-btn:hover { background: rgba(255, 255, 255, 0.08); }\n.fps-badge {\n  padding: 4px 8px; color: var(--orange); font-size: 11px; font-weight: bold;\n  background: rgba(255, 152, 0, 0.15); border: 1px solid var(--orange); border-radius: 6px;\n}\n\n/* ── pasek boczny ── */\n.sidebar {\n  display: flex; flex-direction: column;\n  width: 190px; padding-top: 12px;\n  background: var(--bg2); border-right: 1px solid var(--line);\n}\n.nav-item {\n  display: flex; align-items: center; gap: 10px;\n  margin: 2px 8px; padding: 10px 12px;\n  border-radius: 8px; border: 1px solid transparent;\n  color: var(--muted); font-size: 13px; text-align: left;\n}\n.nav-item:hover { background: rgba(255, 255, 255, 0.05); }\n.nav-item.sel { background: rgba(0, 229, 255, 0.12); border-color: rgba(0, 229, 255, 0.3); color: var(--cyan); font-weight: bold; }\n.nav-glyph { width: 18px; text-align: center; font-size: 15px; }\n\n/* ── panel logów ── */\n.logpanel { display: flex; flex-direction: column; height: 180px; background: var(--logbg); border-top: 1px solid var(--line); }\n.logpanel.collapsed { height: 36px; }\n.log-head { display: flex; align-items: center; gap: 8px; height: 36px; padding: 0 12px; border-radius: 0; color: var(--cyan); font-size: 12px; font-weight: bold; }\n.log-count { color: var(--faint); font-size: 11px; font-weight: normal; }\n.log-caret { margin-left: auto; color: var(--faint); }\n.log-body, .wiz-log { flex: 1; min-height: 0; overflow-y: auto; padding: 4px 12px; }\n.log-line { font-size: 11px; color: var(--muted); white-space: pre-wrap; }\n.log-line.err { color: var(--red); }\n.log-line.ok { color: var(--green); }\n\n/* ── przyciski ── */\n.btn {\n  display: inline-flex; align-items: center; justify-content: center; gap: 6px;\n  padding: 9px 16px; font-size: 13px;\n  background: var(--cyan); color: #000; border-color: var(--cyan); border-radius: 8px;\n}\n.btn:hover { background: #4df0ff; }\n.btn.flat { background: transparent; color: var(--cyan); border-color: transparent; }\n.btn.flat:hover { background: rgba(0, 229, 255, 0.1); }\n.btn.outline { background: transparent; color: var(--text); border-color: var(--border); }\n.btn.outline:hover { background: rgba(255, 255, 255, 0.06); }\n.btn.wide { width: 100%; }\n.btn.small-btn { padding: 6px 12px; font-size: 12px; }\n.btn.big-btn { width: 100%; padding: 16px; font-size: 15px; margin-top: 8px; }\n.mini {\n  padding: 6px 10px; font-size: 13px; color: var(--cyan);\n  background: rgba(0, 229, 255, 0.1); border-radius: 6px;\n}\n.mini.green { color: var(--green); background: rgba(105, 240, 174, 0.1); }\n.mini.red { color: var(--red); background: rgba(255, 82, 82, 0.1); }\n.mini:hover { background: rgba(255, 255, 255, 0.14); }\n\n/* ── strony ── */\n.page { flex: 1; min-width: 0; min-height: 0; padding: 24px; }\n.page.col { display: flex; flex-direction: column; gap: 12px; }\n.page.scroll { overflow-y: auto; }\n.page.nopad-bottom { padding-bottom: 12px; }\n.page-head { display: flex; align-items: center; gap: 10px; }\n.page-title { margin: 0; font-size: 18px; font-weight: bold; }\n.page-title.big { font-size: 22px; margin-bottom: 20px; }\n.scroll { overflow-y: auto; }\n\n/* ── karty ── */\n.card { background: var(--card); border-radius: 12px; }\n.card.pad { padding: 16px; }\n.banner {\n  display: flex; align-items: flex-start; gap: 8px;\n  padding: 10px; font-size: 12px; color: var(--soft); border-radius: 8px;\n}\n.banner.blue { background: rgba(68, 138, 255, 0.08); border: 1px solid rgba(68, 138, 255, 0.2); }\n.banner.amber { background: rgba(255, 193, 7,